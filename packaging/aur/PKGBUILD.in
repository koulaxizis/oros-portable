# Maintainer: koulaxizis <koulaxizis@users.noreply.github.com>
# Generated by the orOS Portable release workflow from packaging/aur/PKGBUILD.in.
pkgname=oros-bin
pkgver=@VERSION@
pkgrel=1
pkgdesc="orOS, the offline-first workspace: notes, calendar, files, office apps and games that work without internet"
arch=('x86_64')
url="https://useoros.online"
license=('MIT' 'BSD-3-Clause')
depends=('alsa-lib' 'at-spi2-core' 'cairo' 'dbus' 'expat' 'gtk3' 'libcups' 'libdrm' 'libx11'
         'libxcb' 'libxcomposite' 'libxdamage' 'libxext' 'libxfixes' 'libxkbcommon' 'libxrandr'
         'mesa' 'nspr' 'nss' 'pango')
provides=('oros')
conflicts=('oros')
options=('!strip' '!debug')
source=("https://github.com/koulaxizis/oros-portable/releases/download/v${pkgver}/oros_${pkgver}_amd64.deb")
sha256sums=('@DEBSHA256@')

package() {
  bsdtar -xf "$srcdir/data.tar.xz" -C "$srcdir"
  install -d "$pkgdir/usr/lib"
  # /usr/lib/oros, not the .deb's /opt/oros: the launcher treats /opt/oros as
  # a .deb install and would offer apt-get updates.
  cp -a "$srcdir/opt/oros" "$pkgdir/usr/lib/oros"
  # Releases come through pacman; the launcher still updates the orOS app.
  echo aur > "$pkgdir/usr/lib/oros/package-managed"
  install -d "$pkgdir/usr/bin"
  ln -s /usr/lib/oros/orOS "$pkgdir/usr/bin/oros"
  install -Dm644 "$srcdir/usr/share/applications/oros.desktop" "$pkgdir/usr/share/applications/oros.desktop"
  install -Dm644 "$srcdir/usr/share/icons/hicolor/512x512/apps/oros.png" "$pkgdir/usr/share/icons/hicolor/512x512/apps/oros.png"
  install -d "$pkgdir/usr/share/licenses/$pkgname"
  cp -a "$srcdir/opt/oros/LICENSES/." "$pkgdir/usr/share/licenses/$pkgname/"
}
