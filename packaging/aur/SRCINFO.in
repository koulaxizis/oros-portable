pkgbase = oros-bin
	pkgdesc = orOS, the offline-first workspace: notes, calendar, files, office apps and games that work without internet
	pkgver = @VERSION@
	pkgrel = 1
	url = https://useoros.online
	arch = x86_64
	license = MIT
	license = BSD-3-Clause
	depends = alsa-lib
	depends = at-spi2-core
	depends = cairo
	depends = dbus
	depends = expat
	depends = gtk3
	depends = libcups
	depends = libdrm
	depends = libx11
	depends = libxcb
	depends = libxcomposite
	depends = libxdamage
	depends = libxext
	depends = libxfixes
	depends = libxkbcommon
	depends = libxrandr
	depends = mesa
	depends = nspr
	depends = nss
	depends = pango
	provides = oros
	conflicts = oros
	options = !strip
	options = !debug
	source = https://github.com/koulaxizis/oros-portable/releases/download/v@VERSION@/oros_@VERSION@_amd64.deb
	sha256sums = @DEBSHA256@

pkgname = oros-bin
